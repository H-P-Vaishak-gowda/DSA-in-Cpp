Time Complexity: O(n²)
Auxiliary Space: O(1)
Output Space: O(n²)

class Solution {
public:
    vector<int> downwardDiagonal(vector<vector<int>>& mat) {

        int n = mat.size();
        vector<int> ans;

        // There are 2*n - 1 anti-diagonals
        for(int sum = 0; sum <= 2 * n - 2; sum++) {

            for(int i = 0; i < n; i++) {

                int j = sum - i;

                if(j >= 0 && j < n) {
                    ans.push_back(mat[i][j]);
                }
            }
        }

        return ans;
    }
};
