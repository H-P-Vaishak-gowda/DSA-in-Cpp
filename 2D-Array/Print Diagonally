class Solution {
public:
    vector<int> downwardDiagonal(vector<vector<int>>& mat) {

        int n = mat.size();
        vector<int> ans;

        for(int sum = 0; sum <= 2 * n - 2; sum++) {

            int start = max(0, sum - n + 1);

            for(int i = start; i < n && sum - i >= 0; i++) {
                ans.push_back(mat[i][sum - i]);
            }
        }

        return ans;
    }
};

