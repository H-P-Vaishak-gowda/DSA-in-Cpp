Time Complexity: O(n^2)
Auxiliary Space: O(1)

class Solution {
public:
    bool magicSquare(vector<vector<int>>& mat) {

        long long n = mat.size();
        long long N = n * n;

        // Required magic sum
        long long target = n * (N + 1) / 2;

        // Expected sum of 1...N
        long long expectedSum = N * (N + 1) / 2;

        // Expected sum of squares: 1² + 2² + ... + N²
        long long expectedSquareSum =
            N * (N + 1) * (2 * N + 1) / 6;

        long long totalSum = 0;
        long long squareSum = 0;

        // Check rows, values and collect sums
        for (int i = 0; i < n; i++) {

            long long rowSum = 0;
            long long colSum = 0;

            for (int j = 0; j < n; j++) {

                long long x = mat[i][j];

                // Must be between 1 and n²
                if (x < 1 || x > N)
                    return false;

                rowSum += x;
                colSum += mat[j][i];

                totalSum += x;
                squareSum += x * x;
            }

            if (rowSum != target || colSum != target)
                return false;
        }

        // Check that elements are exactly 1...n²
        if (totalSum != expectedSum ||
            squareSum != expectedSquareSum)
            return false;

        // Check diagonals
        long long diagonal1 = 0;
        long long diagonal2 = 0;

        for (int i = 0; i < n; i++) {
            diagonal1 += mat[i][i];
            diagonal2 += mat[i][n - 1 - i];
        }

        return diagonal1 == target && diagonal2 == target;
    }
};

