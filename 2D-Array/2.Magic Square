class Solution {
public:
    bool magicSquare(vector<vector<int>>& mat) {

        int n = mat.size();
        vector<int> ans;

        int compare_sum = 0;

        // Check rows
        for(int i = 0; i < n; i++) {

            int sum = 0;

            for(int j = 0; j < n; j++) {
                sum += mat[i][j];
                ans.push_back(mat[i][j]);
            }

            if(i == 0) {
                compare_sum = sum;
            }
            else if(sum != compare_sum) {
                return false;
            }
        }

        // Check columns
        for(int j = 0; j < n; j++) {

            int sum = 0;

            for(int i = 0; i < n; i++) {
                sum += mat[i][j];
            }

            if(sum != compare_sum) {
                return false;
            }
        }

        // Check main diagonal
        int sum = 0;

        for(int i = 0; i < n; i++) {
            sum += mat[i][i];
        }

        if(sum != compare_sum) {
            return false;
        }

        // Check secondary diagonal
        sum = 0;

        for(int i = 0; i < n; i++) {
            sum += mat[i][n - 1 - i];
        }

        if(sum != compare_sum) {
            return false;
        }

        // Check numbers from 1 to n²
        sort(ans.begin(), ans.end());

        for(int i = 0; i < n * n; i++) {

            if(ans[i] != i + 1) {
                return false;
            }
        }

        return true;
    }
};
Time  : O(n² log n)
Space : O(n²)


