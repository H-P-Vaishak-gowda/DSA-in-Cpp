class Solution {
public:
    bool magicSquare(vector<vector<int>>& mat) {

        int n = mat.size();
        int target = 0;

        // Target sum = first row
        for(int j = 0; j < n; j++) {
            target += mat[0][j];
        }

        // Check rows and numbers
        vector<bool> seen(n * n + 1, false);

        for(int i = 0; i < n; i++) {

            int rowSum = 0;

            for(int j = 0; j < n; j++) {

                int x = mat[i][j];

                // Number must be from 1 to n²
                if(x < 1 || x > n * n || seen[x]) {
                    return false;
                }

                seen[x] = true;
                rowSum += x;
            }

            if(rowSum != target) {
                return false;
            }
        }

        // Check columns
        for(int j = 0; j < n; j++) {

            int colSum = 0;

            for(int i = 0; i < n; i++) {
                colSum += mat[i][j];
            }

            if(colSum != target) {
                return false;
            }
        }

        // Main diagonal
        int diagonal1 = 0;

        // Secondary diagonal
        int diagonal2 = 0;

        for(int i = 0; i < n; i++) {

            diagonal1 += mat[i][i];
            diagonal2 += mat[i][n - 1 - i];
        }

        if(diagonal1 != target || diagonal2 != target) {
            return false;
        }

        return true;
    }
};
Time: O(n²)
Auxiliary space: O(n²)
