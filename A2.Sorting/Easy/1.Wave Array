class Solution {
  public:
    void sortInWave(vector<int>& arr) {
        int n=arr.size();
        
        
        int k;
        
        for(int i=0;i<n-1;i+=2){
            k=arr[i];
            arr[i]=arr[i+1];
            arr[i+1]=k;
        }
    }
};

