class Solution {
  public:
    void sortInWave(vector<int>& arr) {
        int n=arr.size();
        vector<int> ans;
        
        for(int i=0;i<n;i+=2){
            for(int j=i+1;j<n;j+=2){
                
                if(i!=n-1){
                    ans.push_back(arr[j]);
                    ans.push_back(arr[i]);
                    break;
                }

            }
            if(i==n-1){
                ans.push_back(arr[n-1]);
            } 
        }
        arr=ans;
    }
};
