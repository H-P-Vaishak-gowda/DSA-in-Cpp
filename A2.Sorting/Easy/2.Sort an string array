class Solution {
  public:
    void sortByLength(vector<string>& arr){
        stable_sort(arr.begin(),arr.end(),
            
            [](const string &a,const string &b){
                return a.length()<b.length();
            }
        );    
    }   
    
};
Complexity	Value
Time Complexity	O(n log n)
Auxiliary Space	O(n) typically
