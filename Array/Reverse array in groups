class Solution {
public:
    void reverseInGroups(vector<int> &arr, int k) {
        int n = arr.size();

        for (int i = 0; i < n; i += k) {
            int st = i;
            int end = min(i + k - 1, n - 1);

            while (st < end) {
                swap(arr[st], arr[end]);
                st++;
                end--;
            }
        }
    }

    
};

class Solution {
public:
    void reverseInGroups(vector<int> &arr, int k) {
        int n = arr.size();

        for (int i = 0; i < n; i += k) {
            int end = min(i + k, n);
            reverse(arr.begin() + i, arr.begin() + end);
        }
    }
};
