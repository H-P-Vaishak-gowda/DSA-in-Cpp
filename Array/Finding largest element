1.Find the largest element in an array

[My Approach]
int main() {
    int marks[] = {-4, -5, 6, -5, -50, 50, 34, 56, 78, 890, 90, 67, 67, 788};

    int a = sizeof(marks) / sizeof(int);
    int largest = 0;

    for (int i = 0; i < a; i++) {
        if (largest <= marks[i]) {
            largest = marks[i];
        }
    }

    cout << "The largest element in an array is : " << largest << endl;

    int index = 0;

    for (int i = 0; i < a; i++) {
        if (marks[i] == largest) {
            index = i;
        }
    }

    cout << "The index of the largest number is : " << index;

    return 0;
}

[Chat gpt approach]

int main() {
    int marks[] = {-4,-5,6,-5,-50,50,34,56,78,890,90,67,67,788};

    int n = sizeof(marks) / sizeof(marks[0]);

    int largest = marks[0];
    int index = 0;

    for (int i = 1; i < n; i++) {
        if (marks[i] > largest) {
            largest = marks[i];
            index = i;
        }
    }

    cout << "Largest element: " << largest << endl;
    cout << "Index: " << index << endl;

    return 0;
}

