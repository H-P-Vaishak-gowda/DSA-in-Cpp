class Solution {
public:
    vector<int> findMajority(vector<int>& arr) {

        int n = arr.size();
        unordered_map<int, int> freq;
        vector<int> ans;

        for(int x : arr) {
            freq[x]++;
        }

        for(auto it : freq) {
            if(it.second > n / 3) {
                ans.push_back(it.first);
            }
        }

        sort(ans.begin(), ans.end());

        return ans;
    }
};
