method-03
class Solution {
public:
    vector<int> findMajority(vector<int>& arr) {

        int n = arr.size();
        vector<int> ans;

        sort(arr.begin(), arr.end());

        for(int i = 0; i < n; ) {

            int j = i;

            while(j < n && arr[j] == arr[i]) {
                j++;
            }

            if(j - i > n / 3) {
                ans.push_back(arr[i]);
            }

            i = j;
        }

        return ans;
    }
};
