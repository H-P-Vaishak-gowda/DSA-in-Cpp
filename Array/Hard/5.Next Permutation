class Solution {
public:
    void nextPermutation(vector<int>& arr) {

        int n = arr.size();

        // 1. Find pivot
        int k = n - 2;

        while (k >= 0 && arr[k] >= arr[k + 1]) {
            k--;
        }

        // 2. If no pivot, array is the largest permutation
        if (k < 0) {
            reverse(arr.begin(), arr.end());
            return;
        }

        // 3. Find the first element from right greater than pivot
        int h = n - 1;

        while (arr[h] <= arr[k]) {
            h--;
        }

        // 4. Swap pivot with that element
        swap(arr[k], arr[h]);

        // 5. Reverse the part after pivot
        reverse(arr.begin() + k + 1, arr.end());
    }
};
