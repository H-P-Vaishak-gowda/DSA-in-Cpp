class Solution {
public:
    void nextPermutation(vector<int>& arr) {

        int n = arr.size();

        vector<int> storage;

        int pivot = -1;
        int k = -1;
        int end = -1;
        int h = -1;

        // 1. Find pivot
        for (int i = n - 1; i > 0; i--) {

            storage.push_back(arr[i]);

            if (arr[i - 1] < arr[i]) {
                pivot = arr[i - 1];
                k = i - 1;
                break;
            }
        }

        // 2. No pivot means this is the largest permutation
        if (k == -1) {
            sort(arr.begin(), arr.end());
            return;
        }

        // 3. Sort the elements after pivot
        sort(storage.begin(), storage.end());

        // 4. Find the smallest element greater than pivot
        for (int j = 0; j < storage.size(); j++) {

            if (storage[j] > pivot) {
                end = storage[j];
                break;
            }
        }

        // 5. Find the index of 'end' in the original array
        for (int j = k + 1; j < n; j++) {

            if (arr[j] == end) {
                h = j;
                break;
            }
        }

        // 6. Swap pivot and end
        swap(arr[k], arr[h]);

        // 7. Sort everything after pivot
        sort(arr.begin() + k + 1, arr.end());
    }
};

