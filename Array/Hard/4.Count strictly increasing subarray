class Solution {
  public:
    int countIncreasing(vector<int>& arr) {
        
        int n=arr.size();
        vector<vector<int>>ans;
        
        for(int i=0;i<n-1;i++){
            
            vector<int>sub_ans;
            sub_ans.push_back(arr[i]);
            
            int d=i;
            for(int j=i+1;j<n;j++){
                
                if(arr[d]<arr[j]){
                    sub_ans.push_back(arr[j]);
                    ans.push_back(sub_ans);
                    d++;
                }
                else{
                    break;
                }
            }
        }
        
        int result=ans.size();
        
        return result;
    }
};
