class Solution {
	public:
	int countIncreasing(vector<int>& arr) {
		
		vector<vector<int>> ans;
		
		int n = arr.size();
		
		for (int i = 0; i<n; i++) {
			
  			vector<int>sub_ans;
  			sub_ans.push_back(arr[i]);
  			
  			
  			
  			for (int j = i; j<n-1; j++) {
  				if (arr[j]<arr[j+1]) {
  					sub_ans.push_back(arr[j+1]);
  					ans.push_back(sub_ans);
  					
  				}
  				else{
  				    break;
  				}
				
			}
			
			
		}
		int k = ans.size();
		return k;
	}
	    
	    
};

