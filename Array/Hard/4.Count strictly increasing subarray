class Solution {
public:
    int countIncreasing(vector<int>& arr) {

        int n = arr.size();
        int result = 0;
        int count = 0;

        for (int i = 1; i < n; i++) {

            if (arr[i - 1] < arr[i]) {
                count++;
                result += count;
            }
            else {
                count = 0;
            }
        }

        return result;
    }
};
