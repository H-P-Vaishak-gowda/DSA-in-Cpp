class Solution {
public:
    int subarraySum(vector<int>& arr) {

        int n = arr.size();
        int final_add = 0;

        for (int i = 0; i < n; i++) {

            final_add += arr[i] * (i + 1) * (n - i);

        }

        return final_add;
    }
};
