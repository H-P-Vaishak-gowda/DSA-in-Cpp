class Solution {
	public:
	int subarraySum(vector<int>& arr) {
		
		int n = arr.size();
		vector<int> ans;
		
		int final_add = 0;
		
		for (int i = 0; i<n; i++) {
			
			int add = 0;
			for (int j = i; j<n; j++) {
				
				add += arr[j];
				ans.push_back(add);
				
			}
			
		}
		
		for (int k = 0; k<ans.size(); k++) {
			final_add += ans[k];
		}
		return final_add;
		
	}
};
