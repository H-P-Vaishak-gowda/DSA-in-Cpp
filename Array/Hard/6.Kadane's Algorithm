class Solution {
public:
    int maxSubarraySum(vector<int> &arr) {

        int current = arr[0];
        int big = arr[0];

        for (int i = 1; i < arr.size(); i++) {

            current = max(arr[i], current + arr[i]);

            big = max(big, current);
        }

        return big;
    }
};

Time:  O(n)
Space: O(1)
