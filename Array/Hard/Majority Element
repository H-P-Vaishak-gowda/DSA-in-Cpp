class Solution {
public:
    int majorityElement(vector<int>& arr) {

        int n = arr.size();

        unordered_map<int, int> freq;

        for(int i = 0; i < n; i++) {

            int k = arr[i];

            freq[k]++;

            if(freq[k] > n / 2) {
                return k;
            }
        }

        return -1;
    }
};
