Best approach (Boyer-Moore Voting Algorithm):

class Solution {
public:
    int majorityElement(vector<int>& arr) {

        int candidate = 0;
        int count = 0;

        // Find a possible majority element
        for(int x : arr) {

            if(count == 0) {
                candidate = x;
                count = 1;
            }
            else if(x == candidate) {
                count++;
            }
            else {
                count--;
            }
        }

        // Verify the candidate
        count = 0;

        for(int x : arr) {
            if(x == candidate) {
                count++;
            }
        }

        if(count > arr.size() / 2)
            return candidate;

        return -1;
    }
};
