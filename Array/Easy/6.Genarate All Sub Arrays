TC-O(n2)

class Solution {
public:
    vector<vector<int>> getSubArrays(vector<int>& arr) {
        int n = arr.size();
        vector<vector<int>> ans;

        for (int i = 0; i < n; i++) {
            vector<int> sub_ans;

            for (int j = i; j < n; j++) {
                sub_ans.push_back(arr[j]);
                ans.push_back(sub_ans);
            }
        }

        return ans;
    }
};
