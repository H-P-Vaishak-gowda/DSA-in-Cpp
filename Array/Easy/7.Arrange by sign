class Solution {
public:
    void rearrange(vector<int> &arr) {
        int n = arr.size();

        vector<int> positive,negative,ans;
    
        // Separate positive and negative numbers
        for (int i = 0; i < n; i++) {
            if (arr[i] >= 0) {
                positive.push_back(arr[i]);
            } else {
                negative.push_back(arr[i]);
            }
        }

        int p = 0;
        int neg = 0;

        // Add positive and negative alternately
        while (p < positive.size() && neg < negative.size()) {
            ans.push_back(positive[p]);
            p++;

            ans.push_back(negative[neg]);
            neg++;
        }

        // Add remaining positive numbers
        while (p < positive.size()) {
            ans.push_back(positive[p]);
            p++;
        }

        // Add remaining negative numbers
        while (neg < negative.size()) {
            ans.push_back(negative[neg]);
            neg++;
        }

        // Copy answer back to original array
        arr = ans;
    }
};
