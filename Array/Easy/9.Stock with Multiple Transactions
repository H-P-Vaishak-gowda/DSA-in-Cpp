class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int total_profit = 0;

        for (int i = 0; i < prices.size() - 1; i++) {
            if (prices[i ] < prices[i+1]) {
                total_profit += prices[i + 1] - prices[i];
            }
        }

        return total_profit;
    }
};
