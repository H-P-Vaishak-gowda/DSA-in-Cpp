2. Reversal Algorithm — ⭐ Best choice
class Solution {
public:
    void rotateArr(vector<int>& arr, int d) {
        int n = arr.size();
        d = d % n;

        reverse(arr.begin(), arr.begin() + d);
        reverse(arr.begin() + d, arr.end());
        reverse(arr.begin(), arr.end());
    }
};

3.std::rotate() — Simplest
class Solution {
public:
    void rotateArr(vector<int>& arr, int d) {
        int n = arr.size();
        d = d % n;

        rotate(arr.begin(), arr.begin() + d, arr.end());
    }
};

4.juggling Algorithm — O(1) Space
class Solution {
public:
    void rotateArr(vector<int>& arr, int d) {
        int n = arr.size();
        d %= n;

        int g = gcd(n, d);

        for (int i = 0; i < g; i++) {
            int temp = arr[i];
            int j = i;

            while (true) {
                int k = (j + d) % n;

                if (k == i)
                    break;

                arr[j] = arr[k];
                j = k;
            }

            arr[j] = temp;
        }
    }
};

