Attempt-01 [passed 1028/1115 Test cases]
class Solution {
	public:
	void rotateArr(vector<int>& arr, int d) {
		int n = arr.size();
		int k = d%n;
		
		while (k>0) {
			int start = arr[0];
			for (int i = 0; i<n - 1; i++) {
				
				arr[i] = arr[i + 1];
			}
			arr[n - 1] = start;
			k--;
		}
		
	}
};


Attempt-02 [passed all the test cases]

class Solution {
  public:
    void rotateArr(vector<int>& arr, int d) {
        int n=arr.size();
        int k=d%n;
        vector<int>temp=arr;
        int z=0;
        for(int i=0;i<n;i++){
            
            if(i+k<n){
                arr[i]=temp[i+k];
            }
            else{
                arr[i]=temp[z];
                z+=1;
            }
            
        }
    }
};

Complexity
Time: O(n)
Space: O(n) because of vector<int> temp.


