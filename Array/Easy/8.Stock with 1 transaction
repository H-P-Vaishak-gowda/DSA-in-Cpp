class Solution {
	public:
	int maxProfit(vector<int> &prices) {
		int sell, profit = 0;
		int buy = INT_MAX;
		int n = prices.size();
		
		for (int i = 0; i<n - 1; i++) {
			
			int check_buy = buy;
			buy = min(buy, prices[i]);
			if (check_buy != buy) {
				sell = 0;
				
			}
			
			sell = max(sell, prices[i + 1]);
			
			profit = max(profit, sell - buy);
			
		}
		
		return profit;
		
	}
};

