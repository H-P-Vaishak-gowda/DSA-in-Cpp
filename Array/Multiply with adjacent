//Approach -01

class Solution {
	public:
	void updateArray(vector<int>& arr) {

		vector<int> temp = arr;
		
		int n = arr.size();
		
		if (n <= 1) {
			return;
			
		}
		
		for (int i = 0; i<arr.size(); i++) {
			
			if (i == 0) {
				arr[i] = temp[i]*temp[i + 1];
			}
			else if (i == arr.size() - 1) {
				arr[i] = temp[i]*temp[i - 1];
			}
			else {
				arr[i] = temp[i - 1] * temp[i] * temp[i + 1];
			}
			
		}
		
	}
};

//Approach-02

class Solution {
	public:
	void updateArray(vector<int>& arr) {
		
		vector<int> temp = arr;
		
		int n = arr.size();
		
		if (arr.size() <= 1) {
			return;
		}
	
		
		for (int i = 1; i<temp.size() - 1; i++) {
			arr[i] = temp[i - 1] * temp[i] * temp[i + 1];
			
		}
		arr[0] = temp[0]*temp[1];
		arr[temp.size() - 1] = temp[temp.size() - 1]*temp[temp.size() - 2];
		
	}
};
