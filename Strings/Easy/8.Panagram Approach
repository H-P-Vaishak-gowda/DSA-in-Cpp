class Solution {
	public:
	bool checkPangram(string& s) {
		int n = s.size();
		int freq[256] = {0};
		string collect = "";
		
		for (int i = 0; i<n; i++) {
			if (s[i] != ' ') {
				collect += s[i];
			}
		}
		int k=collect.size();
		
		for (int i = 0; i<k; i++) {
			freq[collect[i]]++;
		}
		
		for (int i = 65; i<91; i++) {
			if (freq[i] == 0 && freq[i + 32] == 0) {
				return 0;
			}
		}
		return 1;
		
	}
};

