class Solution {
public:
    bool checkPangram(string& s) {

        bool freq[26] = {false};

        for(char c : s) {

            if(c >= 'a' && c <= 'z')
                freq[c - 'a'] = true;

            else if(c >= 'A' && c <= 'Z')
                freq[c - 'A'] = true;
        }

        for(int i = 0; i < 26; i++) {
            if(freq[i] == false)
                return false;
        }

        return true;
    }
};
