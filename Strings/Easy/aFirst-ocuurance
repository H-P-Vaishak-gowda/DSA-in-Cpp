class Solution {
public:
    int firstOccurence(string& txt, string& pat) {
        int n = txt.size();
        int k = pat.size();

        if (k > n)
            return -1;

        for (int i = 0; i <= n - k; i++) {
            int j = 0;

            while (j < k && txt[i + j] == pat[j]) {
                j++;
            }

            if (j == k)
                return i;
        }

        return -1;
    }
};
