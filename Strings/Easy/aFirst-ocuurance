class Solution {
	public:
	int firstOccurence(string& txt, string& pat) {
		
		int n = txt.size();
		int k = pat.size();
		string collect = "";
		
		for (int i = 0; i<n; i++) {
			int d = i;
			collect="";
			for (int j = 0; j<k; j++) {
				if (txt[d] == pat[j]) {
					collect += txt[d];
					d++;
				}
			}
			if (collect == pat) {
				return i;
			}
		}
		return - 1;
	}
};
