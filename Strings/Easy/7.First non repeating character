class Solution {
	public:
	char nonRepeatingChar(string &s) {
		
		int n = s.size();
		int count = 0;
		int j, i = 0;
		
		if(n==1){
		    return s[0];
		}
		
		for (int i = 0; i<n - 1; i++) {
			
			for (int j = 0; j<n; j++) {
				
				if (i!=j && s[i] == s[j]) {
					count++;
				}
			}
			if (count>0) {
				count=0;
			}
			else{
			    return s[i];
			}
			
			
		}
		return '$';
		
	}
};
