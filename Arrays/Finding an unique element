*******************************[Mistaskes you did]*******************************

1. times is not reset for each element

You declared:

int match, times = 0;

outside the outer loop.

So when checking 2, times becomes 2.
Then when checking 4, times continues from 2 instead of starting from 0.

You should do:

for(int i = 0; i < size; i++) {
    int times = 0;   // reset here
2. return -1 is inside the outer loop

Currently:

return -1;

is inside the for(i) loop.

That means after checking only the first element, the function exits.

Your code structure is effectively:

for(...) {
    ...
    return -1;   // executes in first iteration
}

Move it outside the loop:

for(...) {
    ...
}
return -1;
3. break is wrong here

You wrote:

if(times > 1)
{
    break;
}

Suppose the first element is not unique (2 appears twice).

break exits the outer loop immediately, so the function never checks 4, 6, or 7.

You should simply continue checking the next element.


*******************************[Correct code]*******************************

#include<iostream>
using namespace std;

int unique(int arr[], int size)
{
    for(int i = 0; i < size; i++)
    {
        int times = 0;

        for(int j = 0; j < size; j++)
        {
            if(arr[j] == arr[i])
            {
                times++;
            }
        }

        if(times == 1)
        {
            return arr[i];
        }
    }

    return -1;
}

int main()
{
    int arr[] = {2,2,4,6,7,4,7};
    int size = 7;

    cout << "The element " << unique(arr,size)
         << " is unique in an array";

    return 0;
}




***********************[Better code for interviews]*******************************

int unique(int arr[], int size)
{
    int ans = 0;

    for(int i = 0; i < size; i++)
    {
        ans ^= arr[i];
    }

    return ans;
}

Note-This runs in O(n) time instead of O(n²) and is a common DSA interview solution.
