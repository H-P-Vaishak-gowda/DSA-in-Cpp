*************[Chat gpt apprach(used 2 pointer approach for better TC but works only when both arrays are sorted]**********

#include <iostream>
using namespace std;

void intersection(int arr1[], int arr2[], int n, int m)
{
    int i = 0;
    int j = 0;

    while (i < n && j < m)
    {
        if (arr1[i] == arr2[j])
        {
            cout << arr1[i] << " ";
            i++;
            j++;
        }
        else if (arr1[i] < arr2[j])
        {
            i++;
        }
        else
        {
            j++;
        }
    }
}

int main()
{
    int arr1[] = {2, 4, 7, 8, 40, 56};
    int arr2[] = {2, 8, 34, 56, 67, 243};

    int n = sizeof(arr1) / sizeof(int);
    int m = sizeof(arr2) / sizeof(int);

    cout << "Intersection: ";
    intersection(arr1, arr2, n, m);

    return 0;
}
