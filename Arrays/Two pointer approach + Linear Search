//1st method

#include<iostream>
using namespace std;

void outcome(int arr[]) {
    for(int i = 0; i < 7; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

void pointer_approach(int arr[]) {
    int s = 0;
    int e = 6;

    while(s < e) {
        swap(arr[s], arr[e]);
        s++;
        e--;
    }

    outcome(arr);
}

int main() {
    int arr[] = {3, 5, 35, 5, 37, 32, 53};

    pointer_approach(arr);

    return 0;
}

//2nd method ->In this type  you gain good experience of using functions.

#include<iostream>
using namespace std;

void print(int arr[]){
    for(int i=0;i<7;i++){
        cout << arr[i] << " ";
    }
    cout << endl;
}

void reverseArray(int arr[]){
    int s = 0, e = 6;

    while(s < e){
        swap(arr[s], arr[e]);
        s++;
        e--;
    }
}

void before_array(int arr[]){
    for(int i=0;i<7;i++){
        cout << arr[i] << " ";
    }
}

int main(){
    int arr[] = {2,4,7,324,56,678,2};

    cout << "Array Before Swapping: ";
    before_array(arr);
    cout << endl;

    reverseArray(arr);

    cout << "Array After Swapping: ";
    print(arr);

    return 0;
}
