***************************************************[TWO POINTER APPROACH]***************************************************
*********//1st method

#include<iostream>
using namespace std;

void outcome(int arr[]) {
    for(int i = 0; i < 7; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

void pointer_approach(int arr[]) {
    int s = 0;
    int e = 6;

    while(s < e) {
        swap(arr[s], arr[e]);
        s++;
        e--;
    }

    outcome(arr);
}

int main() {
    int arr[] = {3, 5, 35, 5, 37, 32, 53};

    pointer_approach(arr);

    return 0;
}

